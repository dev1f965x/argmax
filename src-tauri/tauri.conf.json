{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "argmax",
  "version": "1.0.1",
  "identifier": "io.github.dev1f965x.argmax",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "argmax",
        "width": 420,
        "height": 780,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "dev1f965x",
    "shortDescription": "Picks one for you",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Korean",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/dev1f965x/argmax/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxNEI1RERCOUVFMENDNTQKUldSVXpPQ2UyMTFMNFFHWkh0MnROVC9xa2NDQkRGeG5jcHdyeXBPMkN5V3NvdTFhaDdVZnNzZmQK"
    }
  }
}
