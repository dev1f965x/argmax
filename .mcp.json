{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "exec",
        "playwright-mcp",
        "--headless",
        "--browser",
        "chromium",
        "--no-sandbox",
        "--output-dir",
        "/tmp/playwright-mcp"
      ]
    }
  }
}
