{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Seoul",
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Playwright packages share browser builds and types (and @axe-core/playwright takes playwright-core as a peer); update them together.",
      "groupName": "Playwright",
      "matchPackageNames": [
        "@playwright/test",
        "playwright-core",
        "@playwright/mcp",
        "@axe-core/playwright"
      ]
    },
    {
      "description": "Node.js in CI (.node-version) and in the Dev Container image must change together.",
      "groupName": "Node.js",
      "matchDepNames": [
        "node",
        "mcr.microsoft.com/devcontainers/typescript-node"
      ]
    },
    {
      "description": "Testing Library and Vitest move together.",
      "groupName": "test tooling",
      "matchPackageNames": ["vitest", "jsdom", "/^@testing-library//"]
    },
    {
      "description": "Merge low-risk dev dependency patches after CI passes.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "@playwright/mcp is 0.0.x with no compatibility promise; never automerge it.",
      "matchPackageNames": ["@playwright/mcp"],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "minimumReleaseAge": null
  },
  "automergeStrategy": "squash"
}
